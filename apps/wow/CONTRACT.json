  "status_options": [
    "--project <ProjectId>",
    "--detail summary|capabilities",
    "--format json|text"
  ],
  "check_options": [
    "--project <ProjectId>",
    "--generation current|<ProjectGenerationId>",
    "--file <ProjectFileId>",
    "--rule <RuleId>@<version>",
    "--format json|text"
  ],
  "defaults": {
    "status_detail": "summary",
    "check_generation": "current",
    "check_scope": "AllProjectFiles",
    "check_rules": "E0-service-default",
    "include_generic_findings": true,
    "presentation_mode": "raw_and_roots",
    "format": "json"
  },
  "forbidden_options": [
    "filesystem-path-or-glob-source-scope",
    "source-stdin",
    "apply-or-fix",
    "search-or-replacement",
    "runtime-probe",
    "client-or-editor-discovery",
    "plugin-or-shell-command",
    "daemon-lsp-mcp",
    "release-or-publish"
  ],
  "formats": {
    "json": {
      "canonical": true,
      "stdout": "exact canonical service result JSON plus one final newline",
      "stderr": "empty for valid service operation results",
      "adds_semantic_fields": false,
      "removes_semantic_fields": false,
      "reorders_semantic_fields": false
    },
    "text": {
      "canonical": false,
      "source": "service result records only",
      "must_show": [
        "operation or semantic status",
        "exact project/profile/generation",
        "raw finding count",
        "presentation root and child state",
        "NotEvaluated blockers",
        "deferred state when relevant"
      ],
      "forbidden_claims": [
        "safe",
        "working",
        "runtime verified",
        "tests passed",
        "release ready"
      ]
    }
  },
  "exit_codes": {
    "0": [
      "status available",
      "check clean"
    ],
    "1": [
      "check findings"
    ],
    "2": [
      "status partial",
      "check partial"
    ],
    "3": [
      "structured request/context/generation/deferred/unavailable failure"
    ],
    "4": [
      "internal component/provider/presentation/envelope/serialization failure"
    ],
    "64": [
      "CLI syntax/argument/config-loading failure before service invocation"
    ],
    "130": [
      "cancelled"
    ]
  },
  "stdout_stderr_policy": [
    "valid JSON operation result is written to stdout only",
    "valid text operation result is written to stdout",
    "parser/startup error is written to stderr only",
    "no banner/progress/log on JSON stdout",
    "no partial or double result after cancellation or broken pipe",
    "no raw source, Secret-capable value, absolute path, credential, or private URL leak"
  ],
  "owned_responsibilities": [
    "argument-parsing",
    "service-request-construction",
    "canonical-json-result-serialization",
    "noncanonical-text-projection",
    "stdout-stderr-discipline",
    "exit-code-projection",
