+                        sites.push(BindingSite {
+                            owner: Some(consumer), consumer_id: Some(&consumer.occurrence_id),
+                            inherited_index: Some(inherited_index), ..*source
+                        });
+                    }
+                }
+            }
+        }
+    }
+    Ok(BindingSites { sites, inherited })
