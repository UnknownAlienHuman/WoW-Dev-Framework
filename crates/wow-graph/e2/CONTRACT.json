  "hard_rules": [
    "assertions are primary and materialized views never erase them",
    "semantic keys are producer independent and scope aware",
    "no generic parent semantics",
    "registries are immutable versioned inputs",
    "one batch replaces one exact producer partition atomically",
    "confidence and provenance are never upgraded by aggregation",
    "complete graph storage does not imply complete producer coverage",
    "queries bind exact snapshots and explicit budgets",
    "candidate assertions are excluded by default",
    "paths do not become persisted direct edges",
    "no parser recognizer search service or storage implementation leakage",
    "no raw SQL filesystem network process editor or source execution"
  ],
